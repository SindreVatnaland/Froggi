{
	"appId": "com.Froggi.app",
	"productName": "Froggi",
	"directories": {
		"output": "dist"
	},
	"artifactName": "Froggi-${version}-${os}-${arch}.${ext}",
	"protocols": [
		{
			"name": "Froggi",
			"schemes": ["froggi"]
		}
	],
	"win": {
		"icon": "bin/static/favicon.ico",
		"sign": false,
		"target": [
			{
				"target": "nsis",
				"arch": ["x64"]
			}
		]
	},
	"nsis": {
		"oneClick": true,
		"perMachine": false,
		"allowToChangeInstallationDirectory": false,
		"differentialPackage": true
	},
	"linux": {
		"icon": "bin/static/favicon.ico",
		"target": [
			{
				"target": "AppImage",
				"arch": ["x64"]
			}
		]
	},
	"mac": {
		"icon": "build/icon.png",
		"target": ["default"],
		"extraResources": ["res", "favicon.ico"],
		"entitlements": "entitlements.mac.plist",
		"entitlementsInherit": "entitlements.mac.plist",
		"hardenedRuntime": true,
		"notarize": true,
		"files": [
			"build_electron/**/*",
			"build/**/*",
			"node_modules/**/*",
			{
				"from": "demo-overlays",
				"to": "build_electron/electron/demo-overlays"
			}
		]
	},
	"executableName": "Froggi",
	"asarUnpack": [
		"**/node_modules/@asdf-overlay/**"
	],
	"files": [
		"build_electron/**/*",
		"build/**/*",
		{
			"from": "node_modules",
			"filter": ["dependencies"]
		},
		{
			"from": "node_modules/call-bind-apply-helpers",
			"to": "node_modules/call-bind-apply-helpers"
		},
		{
			"from": "demo-overlays",
			"to": "build_electron/electron/demo-overlays"
		}
	]
}
